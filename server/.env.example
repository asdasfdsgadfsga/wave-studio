# Порт запуска сервера
PORT=3005

# Настройки LLM Provider (OpenAI, OpenRouter, DeepSeek или совместимый API)
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Параметры генерации
TEMPERATURE=0.2
MAX_TOKENS=600
REQUEST_TIMEOUT_MS=30000

# Безопасность и CORS (укажите домен сайта через запятую или * для тестирования)
ALLOWED_ORIGIN=*

# Путь к системной инструкции и базе знаний
SYSTEM_PROMPT_PATH=./system_prompt.txt

# Versioned gallery previews can be cached across deployments.
/images/gallery/previews/v1/*
  Cache-Control: public, max-age=31536000, immutable

# Versioned site artwork retains the existing appearance at smaller file sizes.
/images/site/v1/*
  Cache-Control: public, max-age=31536000, immutable

# Keep audio reusable without delaying updates indefinitely.
/audio/*
  Cache-Control: public, max-age=86400

# Revalidate manifests so newly uploaded samples appear immediately.
/samples.json
  Cache-Control: no-cache
/samples/samples.json
  Cache-Control: no-cache

/admin.html
  Cache-Control: no-store
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

/admin
  Cache-Control: no-store
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
